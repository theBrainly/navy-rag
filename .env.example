# ─────────────────────────────────────────────────────────────
# DLKIP — environment configuration template
# Copy to .env and adjust. Never commit the real .env.
# ─────────────────────────────────────────────────────────────

# Deployment topology: cloud | airgapped
DEPLOYMENT_MODE=cloud

# ── Backend gateway (Node/Express) ───────────────────────────
PORT=4000
AI_SERVICE_URL=http://localhost:8000
MONGODB_URI=mongodb://localhost:27017/dlkip
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-too
STORAGE_PROVIDER=memory          # memory | cloudinary | minio

# ── AI service (Python/FastAPI) ──────────────────────────────
EMBEDDING_MODEL=hashing          # hashing | sentence-transformers
EMBEDDING_DIM=384
VECTOR_BACKEND=memory            # memory | qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=dlkip_chunks

# ── LLM provider ─────────────────────────────────────────────
LLM_PROVIDER=fallback            # fallback | openai | ollama
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── Retrieval tuning ─────────────────────────────────────────
TOP_K=5
CONFIDENCE_THRESHOLD=0.15
CHUNK_SIZE=600
CHUNK_OVERLAP=80
